    {
      "id": "math-frac",
      "title": "数学 · 分数与负数",
      "kind": "quiz",
      "cards": [
        {
          "id": "m-001", "front": "1/2 + 1/3 = ?", "back": "5/6",
          "options": ["2/5", "5/6", "1/5", "2/6"],
          "explain": "通分到 6：3/6 + 2/6 = 5/6。分母不同不能直接加分子。"
        },
        {
          "id": "m-002", "front": "−3 + 5 = ?", "back": "2",
          "options": ["−8", "2", "−2", "8"],
          "explain": "负数加正数，等于大数减小数，符号跟大数走：5 − 3 = 2。"
        },
        {
          "id": "m-003", "front": "2/3 × 3/4 = ?", "back": "1/2",
          "options": ["5/7", "1/2", "6/7", "2/4"],
          "explain": "分子乘分子、分母乘分母：6/12 = 1/2。能约分的先约分更快。"
        },
        {
          "id": "m-004", "front": "2x + 5 = 13，x = ?", "back": "4",
          "options": ["3", "4", "9", "6"],
          "explain": "两边先减 5 得 2x = 8，再除以 2 得 x = 4。"
        },
        {
          "id": "m-005", "front": "(−2) × (−3) = ?", "back": "6",
          "options": ["−6", "6", "−5", "5"],
          "explain": "负负得正。两个负号相乘结果为正。"
        },
        {
          "id": "m-006", "front": "1/2 ÷ 1/4 = ?", "back": "2",
          "options": ["1/8", "2", "1/2", "8"],
          "explain": "除以分数等于乘它的倒数：1/2 × 4/1 = 2。"
        },
        {
          "id": "m-007", "front": "−5 − (−8) = ?", "back": "3",
          "options": ["−13", "3", "−3", "13"],
          "explain": "减负等于加正：−5 + 8 = 3。"
        },
        {
          "id": "m-008", "front": "0.25 化成最简分数是？", "back": "1/4",
          "options": ["1/2", "1/4", "2/5", "1/5"],
          "explain": "0.25 = 25/100，上下同除 25 得 1/4。"
        },
        {
          "id": "m-009", "front": "3/4 和 5/8 哪个大？", "back": "3/4",
          "options": ["3/4", "5/8", "一样大", "无法比较"],
          "explain": "通分：3/4 = 6/8，6/8 > 5/8。"
        },
        {
          "id": "m-010", "front": "−2x = 6，x = ?", "back": "−3",
          "options": ["3", "−3", "−12", "12"],
          "explain": "两边同除以 −2，6 ÷ (−2) = −3。"
        }
      ]
    }
  ]
